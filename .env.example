# ==============================================================================
# MikroTik HotSpot Management System - Global Environment Template
# ==============================================================================

# Backend Configuration
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,https://your-username.github.io
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Database Configuration (PostgreSQL / CockroachDB / Supabase / Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mikrotik_hotspot?schema=public"

# MikroTik Connection Mode:
# Options: 'MOCK' | 'BACKEND_DIRECT_VPN' | 'CONNECTOR_AGENT'
# Safe default is MOCK
MIKROTIK_CONNECTION_MODE=MOCK
MIKROTIK_MOCK_MODE=true

# MikroTik Router Credentials (Used only in DIRECT_VPN mode or Connector Agent)
MIKROTIK_HOST=10.10.13.38
MIKROTIK_API_PORT=8728
MIKROTIK_API_SSL=false
MIKROTIK_USERNAME=api_hotspot_admin
MIKROTIK_PASSWORD=secure_router_password

# Connector Agent Security
CONNECTOR_SECRET=system-connector-registration-secret-key

# Frontend Public Environment (Used in apps/frontend)
# In production on GitHub Pages, set to your serverless backend URL (e.g. https://api.yourdomain.com)
VITE_API_BASE_URL=http://localhost:4000/api
VITE_APP_NAME="Smart HotSpot Manager"
VITE_DEFAULT_LOCALE=bn
